# Copy to .env and export, or set in your shell. Never commit real keys.
# API keys: "key:user:role,..." with roles public | clinician | admin.
# These development keys are also the built-in default when RAG_API_KEYS is unset.
RAG_API_KEYS=dev-public-key:alice:public,dev-clinician-key:bob:clinician,dev-admin-key:ops:admin

# Inference backend: mlx (Apple silicon, in-process) or openai_compatible (a model
# server on this machine, e.g. `mlx_lm.server`; hosted APIs are refused).
RAG_BACKEND=mlx
RAG_MODEL_ID=mlx-community/Qwen2.5-1.5B-Instruct-4bit
RAG_MODEL_SERVER_URL=http://127.0.0.1:8080/v1

# Optional path overrides
# RAG_DATA_DIR=./data
# RAG_STORAGE_DIR=./storage
# RAG_RESULTS_DIR=./results

# UI -> API
RAG_API_URL=http://127.0.0.1:8000
